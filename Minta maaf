<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Untuk Kamu ❤️</title>

<style>
body {
    margin: 0;
    padding: 0;
    background: linear-gradient(to top, #ff758c, #ff7eb3);
    font-family: 'Segoe UI', sans-serif;
    text-align: center;
    color: white;
    overflow: hidden;
}

.container {
    margin-top: 60px;
    animation: fadeIn 2s ease-in;
}

img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 4px solid white;
    object-fit: cover;
    margin-bottom: 20px;
}

h1 {
    font-size: 35px;
}

p {
    font-size: 18px;
    width: 80%;
    margin: auto;
    line-height: 1.6;
}

button {
    margin-top: 20px;
    padding: 12px 25px;
    font-size: 16px;
    border: none;
    border-radius: 10px;
    background: white;
    color: #ff4d6d;
    cursor: pointer;
}

@keyframes fadeIn {
    from {opacity: 0;}
    to {opacity: 1;}
}

/* Love animation */
.heart {
    position: absolute;
    color: white;
    font-size: 20px;
    animation: float 6s linear infinite;
}

@keyframes float {
    0% {transform: translateY(100vh); opacity: 0;}
    50% {opacity: 1;}
    100% {transform: translateY(-10vh); opacity: 0;}
}
</style>
</head>

<body>

<div class="container">
    <!-- GANTI FOTO DI SINI -->
    <img src="https://i.imgur.com/yourphoto.jpg" alt="foto kamu">

    <!-- GANTI NAMA PACAR -->
    <h1>Untuk Kamu, Sayangku ❤️</h1>

    <p id="text"></p>

    <button onclick="playMusic()">Klik dulu ya 😢</button>
</div>

<!-- Musik (ganti kalau mau) -->
<audio id="music" loop>
    <source src="https://www.bensound.com/bensound-music/bensound-romantic.mp3" type="audio/mp3">
</audio>

<script>
const message = `
Aku tau aku salah…
Aku bener-bener minta maaf ya 😔

Aku nggak pernah ada niat buat nyakitin kamu…
Kamu itu berharga banget buat aku ❤️

Kalau aku bisa ulang waktu,
aku bakal perbaiki semuanya…

Tolong maafin aku ya…
Aku sayang kamu 🥺
`;

let i = 0;
function typing() {
    if (i < message.length) {
        document.getElementById("text").innerHTML += message.charAt(i);
        i++;
        setTimeout(typing, 40);
    }
}

typing();

function playMusic() {
    document.getElementById("music").play();
    alert("Aku harap kamu baca sampai selesai ❤️");
}

// efek love
function createHeart() {
    const heart = document.createElement("div");
    heart.classList.add("heart");
    heart.innerHTML = "❤️";
    heart.style.left = Math.random() * 100 + "vw";
    heart.style.fontSize = (Math.random() * 20 + 10) + "px";
    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 6000);
}

setInterval(createHeart, 300);
</script>

</body>
</html>
